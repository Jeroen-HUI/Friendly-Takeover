{
  "name": "friendly-takeover",
  "version": "0.1.0",
  "description": "Friendly Takeover \u2014 multiplayer business game engine",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "tsx --test test/*.test.ts",
    "sim": "tsx src/sim/simulate.ts 500 chocolate standard",
    "sim:ai": "tsx src/sim/simulate.ts 500 ai standard",
    "sim:weed": "tsx src/sim/simulate.ts 500 weed standard",
    "trace": "tsx src/sim/simulate.ts trace chocolate 7",
    "diagnose": "tsx src/sim/diagnose.ts chocolate",
    "analyze": "tsx src/sim/analyze.ts 80",
    "balance": "tsx src/sim/balance.ts 60"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^24.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module"
}
